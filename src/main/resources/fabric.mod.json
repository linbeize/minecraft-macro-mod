{
  "schemaVersion": 1,
  "id": "client_utilities",
  "version": "${version}",
  "name": "Client Utilities",
  "description": "Scriptable client-side macros (keys, mouse, delays, loops) with an in-game editor.",
  "authors": ["linbei"],
  "contact": {
    "sources": "https://github.com/linbeize/minecraft-macro-mod"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["de.linbei.macro.MacroModClient"]
  },
  "mixins": [
    "client_utilities.mixins.json"
  ],
  "depends": {
    "fabricloader": "${min_loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=25"
  }
}
